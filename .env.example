RELAY_MODE=aperture
# aperture (default), openrouter, or both. OpenRouter needs public HTTPS ingress.
# Both modes require APERTURE_API_KEY plus the OpenRouter relay credentials below.
OPENROUTER_RELAY_PUBLIC_KEY=
OPENROUTER_RELAY_SECRET_KEY=
OPENROUTER_MAX_IN_FLIGHT=8

TSNET_ENABLED=true
TSNET_TLS_ENABLED=false
TSNET_HOSTNAME=aperture-langfuse-relay
# Local default for `go run .`; for Docker/systemd use a persistent absolute path.
TSNET_STATE_DIR=./.tsnet
# Optional but recommended for headless/container deploys.
TS_AUTHKEY=

# Regular TCP and tsnet app port. Compose does not publish it by default.
LISTEN_ADDR=:8080
HEALTH_LISTEN_ADDR=:8081
WEBHOOK_PATH=/hooks/aperture

# Optional only in aperture mode; required in both mode. Set it for any public webhook.
APERTURE_API_KEY=

# Actual PRIVATE Langfuse project credentials. OpenRouter gets the independent
# OPENROUTER_RELAY_* credentials above, never these keys.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Set true to dial the private Langfuse origin through this embedded tailnet node.
# Leave false for Docker-local service names and ordinary network access.
LANGFUSE_USE_TSNET=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_ENV=production

REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
# Applies to incoming payloads; OpenRouter enforces both wire and decoded gzip size.
MAX_REQUEST_BODY_BYTES=3145728
MAX_LANGFUSE_BATCH_BYTES=3145728
QUEUE_SIZE=100
WORKER_COUNT=2
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=250ms
RETRY_MAX_DELAY=5s
